{
  "name": "deviceforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"pnpm --filter @deviceforge/server dev\" \"pnpm --filter @deviceforge/web dev\"",
    "build": "pnpm -r typecheck && pnpm --filter @deviceforge/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @deviceforge/core test && pnpm --filter @deviceforge/web test",
    "start": "pnpm --filter @deviceforge/server start",
    "demo:client": "tsx scripts/send-demo.ts"
  },
  "devDependencies": {
    "@deviceforge/core": "workspace:*",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  }
}
